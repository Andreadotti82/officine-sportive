{
  "version": 2,
  "regions": [
    "cdg1"
  ],
  "rewrites": [
    {
      "source": "/staff",
      "destination": "/contratti.html"
    },
    {
      "source": "/lista",
      "destination": "/lista.html"
    },
    {
      "source": "/gradimento",
      "destination": "/gradimento.html"
    },
    {
      "source": "/disiscrizione",
      "destination": "/disiscrizione.html"
    },
    {
      "source": "/turni",
      "destination": "/turni.html"
    },
    {
      "source": "/contratti",
      "destination": "/contratti.html"
    },
    {
      "source": "/liberatoria",
      "destination": "/contratti.html"
    },
    {
      "source": "/fitcheck",
      "destination": "/fitcheck.html"
    },
    {
      "source": "/actionplan",
      "destination": "/actionplan.html"
    },
    {
      "source": "/goodmorning",
      "destination": "/api/jarvis?pagina=gm"
    },
    {
      "source": "/hw",
      "destination": "/api/jarvis?ponte=hw"
    },
    {
      "source": "/file/:id",
